{
  "name": "kimi-harness",
  "version": "0.1.0",
  "description": "Planning harness — turn vague ideas into concrete, actionable plans",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "kimi-harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "type-check": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:lib": "bun build src/index.ts --outfile=dist/index.js --target=node",
    "build:cli": "bun build src/cli.ts --outfile=dist/cli.js --target=node",
    "build": "bun run build:types && bun run build:lib && bun run build:cli"
  },
  "keywords": [
    "planner",
    "cli",
    "planning",
    "harness",
    "kimi-code"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
