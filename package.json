{
  "name": "kimicode-maru-plan",
  "version": "0.2.0",
  "description": "Ouroboros-grade planning mode for Kimi Code — maru-plan",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "maru-plan": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "skills",
    "kimi.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "type-check": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:lib": "bun build src/index.ts --outfile=dist/index.js --target=node",
    "build:cli": "bun build src/cli.ts --outfile=dist/cli.js --target=node",
    "build:hooks": "bun build src/hooks/index.ts --outfile=dist/hooks/index.js --target=node",
    "build": "bun run build:types && bun run build:lib && bun run build:cli && bun run build:hooks"
  },
  "keywords": [
    "planner",
    "cli",
    "planning",
    "harness",
    "kimi-code",
    "maru-plan",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
